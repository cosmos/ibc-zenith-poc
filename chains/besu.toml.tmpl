# Rendered by scripts/setup-besu.sh — edit the template, not chains/local/besu.toml.
genesis-file           = "/evm/genesis.json"
data-path              = "/data"
node-private-key-file  = "/evm/key"

# Single-validator devnet, but p2p must be enabled or QBFT's pivot selector
# blocks waiting for peers. Discovery off and no bootnodes keeps this chain solo.
p2p-enabled          = true
discovery-enabled    = false
bootnodes            = []
host-allowlist       = ["*"]

rpc-http-enabled      = true
rpc-http-host         = "0.0.0.0"
rpc-http-port         = 8545
rpc-http-cors-origins = ["*"]
rpc-http-api          = ["ETH","NET","WEB3","TXPOOL","DEBUG","ADMIN","QBFT"]

rpc-ws-enabled       = true
rpc-ws-host          = "0.0.0.0"
rpc-ws-port          = 8546
rpc-ws-api           = ["ETH","NET","WEB3","TXPOOL"]

sync-mode            = "FULL"
sync-min-peers       = 0
